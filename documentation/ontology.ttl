@prefix : <https://edint.es/def/agenda#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://edint.es/def/agenda#> .

<https://edint.es/def/agenda> rdf:type owl:Ontology ;
                               owl:versionIRI <https://edint.es/def/agenda> ;
                               <http://purl.org/dc/terms/created> "2026-05-05" ;
                               <http://purl.org/dc/terms/creator> "Daniel Doña" ,
                                                                  "Edna Ruckhaus" ,
                                                                  "Lucía Sánchez" ,
                                                                  "Socorro Bernardos" ;
                               <http://purl.org/dc/terms/description> "The Agenda ontology represents the agenda of cultural, sporting and social events that take place in the municipality."@es ;
                               <http://purl.org/dc/terms/issued> "2026-05-05"^^xsd:date ;
                               <http://purl.org/dc/terms/license> <https://creativecommons.org/licenses/by/4.0/> ;
                               <http://purl.org/dc/terms/title> "Vocabulario para la representación de la agenda cultural, deportiva y social de un municipio"@es ,
                                                                "Vocabulary for the representation of the cultural, sporting and social agenda of a municipality"@en ;
                               <http://purl.org/vocab/vann/preferredNamespacePrefix> "edintagenda" ;
                               <http://purl.org/vocab/vann/preferredNamespaceUri> "https://edint.es/def/agenda#" ;
                               rdfs:comment "https://edint.es/def/agenda" ;
                               owl:priorVersion <https://github.com/EDINT-Ontologia/edint-ontologia-agenda/releases/tag/v0.1.0> ;
                               owl:versionInfo "0.1.1" .

#################################################################
#    Annotation properties
#################################################################

###  http://purl.org/dc/elements/1.1/contributor
<http://purl.org/dc/elements/1.1/contributor> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/created
<http://purl.org/dc/elements/1.1/created> rdf:type owl:AnnotationProperty ;
                                          rdfs:subPropertyOf <http://purl.org/dc/terms/title> .


###  http://purl.org/dc/elements/1.1/creator
<http://purl.org/dc/elements/1.1/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/date
<http://purl.org/dc/elements/1.1/date> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/description
<http://purl.org/dc/elements/1.1/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/elements/1.1/identifier
<http://purl.org/dc/elements/1.1/identifier> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/created
<http://purl.org/dc/terms/created> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/creator
<http://purl.org/dc/terms/creator> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/issued
<http://purl.org/dc/terms/issued> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/license
<http://purl.org/dc/terms/license> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespacePrefix
<http://purl.org/vocab/vann/preferredNamespacePrefix> rdf:type owl:AnnotationProperty .


###  http://purl.org/vocab/vann/preferredNamespaceUri
<http://purl.org/vocab/vann/preferredNamespaceUri> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#definition
<http://www.w3.org/2004/02/skos/core#definition> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#prefLabel
<http://www.w3.org/2004/02/skos/core#prefLabel> rdf:type owl:AnnotationProperty .


#################################################################
#    Datatypes
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type rdfs:Datatype .


###  http://www.w3.org/2001/XMLSchema#date
xsd:date rdf:type rdfs:Datatype .


#################################################################
#    Object Properties
#################################################################

###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#municipio
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#municipio> rdf:type owl:ObjectProperty ;
                                                                                   rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> ;
                                                                                   <http://purl.org/dc/terms/issued> "2014-03-28" ;
                                                                                   rdfs:comment "Municipio al que pertenece un fenómeno geográfico o una entidad administrativa"@es ;
                                                                                   rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                   rdfs:label "pertenece al municipio"@es .


###  http://www.opengis.net/ont/geosparql#hasGeometry
<http://www.opengis.net/ont/geosparql#hasGeometry> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://www.opengis.net/ont/geosparql#Feature> ;
                                                   rdfs:range <http://www.opengis.net/ont/geosparql#Geometry> ;
                                                   <http://purl.org/dc/elements/1.1/contributor> "Matthew Perry" ;
                                                   <http://purl.org/dc/elements/1.1/creator> "OGC GeoSPARQL 1.0 Standard Working Group" ;
                                                   <http://purl.org/dc/elements/1.1/date> "2011-06-16"^^xsd:date ;
                                                   rdfs:comment """
      A spatial representation for a given feature.
    """@en ;
                                                   rdfs:isDefinedBy <http://www.opengis.net/ont/geosparql> ,
                                                                    <http://www.opengis.net/spec/geosparql/1.0> ;
                                                   rdfs:label "hasGeometry"@en .


###  http://www.w3.org/2004/02/skos/core#inScheme
<http://www.w3.org/2004/02/skos/core#inScheme> rdf:type owl:ObjectProperty ;
                                               rdfs:range <http://www.w3.org/2004/02/skos/core#ConceptScheme> ;
                                               rdfs:comment "A concept may be a member of more than one concept scheme."@en ;
                                               rdfs:label "is in scheme"@en .


###  https://edint.es/def/agenda#attendanceMode
:attendanceMode rdf:type owl:ObjectProperty ;
                rdfs:domain :CityEvent ;
                rdfs:range [ rdf:type owl:Restriction ;
                             owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                             owl:hasValue <https://edint.es/kos/AttendanceMode>
                           ] ;
                rdfs:comment "Attendance mode, for example, in person, online."@en ,
                             "Modalidad de asistencia, por ejemplo, presencial, en línea."@es ;
                rdfs:label "attendance mode"@en ,
                           "modalidad de asistencia"@es .


###  https://edint.es/def/agenda#documentation
:documentation rdf:type owl:ObjectProperty ,
                        owl:FunctionalProperty ;
               rdfs:domain :CityEvent ;
               rdfs:range <https://schema.org/DigitalDocument> ;
               rdfs:comment "Documentación asociada a un evento"@es ,
                            "Documentation associated with an event"@en ;
               rdfs:label "documentacion"@es ,
                          "documentation"@en .


###  https://edint.es/def/agenda#eventStatus
:eventStatus rdf:type owl:ObjectProperty ;
             rdfs:subPropertyOf owl:topObjectProperty ;
             rdfs:domain :CityEvent ;
             rdfs:range [ rdf:type owl:Restriction ;
                          owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                          owl:hasValue <https://edint.es/kos/EventStatus>
                        ] ;
             rdfs:comment "Estado de un evento, por ejemplo, activo o cancelado."@es ,
                          "Status of an event, for example, active or cancelled."@en ;
             rdfs:label "estado del evento"@es ,
                        "event status"@en .


###  https://edint.es/def/agenda#eventType
:eventType rdf:type owl:ObjectProperty ,
                    owl:FunctionalProperty ;
           rdfs:domain :CityEvent ;
           rdfs:range [ rdf:type owl:Restriction ;
                        owl:onProperty <http://www.w3.org/2004/02/skos/core#inScheme> ;
                        owl:hasValue <https://edint.es/kos/EventType>
                      ] ;
           rdfs:comment "Tipo de evento que tendrá lugar."@es ,
                        "Type of event to be held."@en ;
           rdfs:label "tipo de evento"@es ,
                      "type of event"@en .


###  https://edint.es/def/agenda#isHeldIn
:isHeldIn rdf:type owl:ObjectProperty ;
          rdfs:domain :CityEvent ;
          rdfs:range [ rdf:type owl:Class ;
                       owl:unionOf ( <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia>
                                     <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio>
                                     <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad>
                                     <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito>
                                     <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio>
                                     <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia>
                                   )
                     ] ;
          rdfs:comment "Relación entre el Evento y la entidad administrativa en donde se celebra, por ejemplo el Barrio o el Distrito."@es ,
                       "Relationship between the Event and the administrative entity where it is held in, for example the Neighborhood or the District."@en ;
          rdfs:label "is held in"@en ,
                     "se celebra en"@es .


###  https://edint.es/def/agenda#organizedBy
:organizedBy rdf:type owl:ObjectProperty ;
             rdfs:domain :CityEvent ;
             rdfs:range <http://schema.org/Organization> ;
             rdfs:comment "Relación entre el evento y la organización que lo gestiona."@es ,
                          "Relationship between the event and the organization that manages it."@en ;
             rdfs:label "organizadoPor"@es ,
                        "organizedBy"@en .


###  https://edint.es/def/agenda#takesPlaceIn
:takesPlaceIn rdf:type owl:ObjectProperty ;
              rdfs:domain :CityEvent ;
              rdfs:range <https://edint.es/def/infraestructura#Facility> ;
              rdfs:comment "El lugar en donde se realiza el evento."@es ,
                           "The venue where the event takes place."@es ;
              rdfs:label "takes place in"@en ,
                         "tiene lugar en"@es .


###  https://edint.es/def/agenda#workPerformed
:workPerformed rdf:type owl:ObjectProperty ;
               rdfs:domain <https://schema.org/Event> ;
               rdfs:range <https://schema.org/CreativeWork> ;
               rdfs:comment "A work performed in some event, for example a play performed in a theater event."@en ,
                            "Una obra representada en algún evento, por ejemplo, una obra de teatro representada en un evento teatral."@es ;
               rdfs:label "obra presentada"@es ,
                          "work performed"@en .


###  https://schema.org/address
<https://schema.org/address> rdf:type owl:ObjectProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain :CityEvent ;
                             rdfs:range <http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal> ;
                             rdfs:comment "Dirección física del artículo."@es ,
                                          "Physical address of the item."@en ;
                             rdfs:label "address"@en ,
                                        "dirección"@es .


###  https://schema.org/subEvent
<https://schema.org/subEvent> rdf:type owl:ObjectProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain <https://schema.org/Event> ;
                              rdfs:range <https://schema.org/Event> ;
                              rdfs:comment "An Event that is part of this event."@en ,
                                           "Un evento que forma parte de este evento."@es ;
                              rdfs:label "sub event"@en ,
                                         "sub evento"@es .


###  https://schema.org/superEvent
<https://schema.org/superEvent> rdf:type owl:ObjectProperty ,
                                         owl:FunctionalProperty ;
                                rdfs:domain <https://schema.org/Event> ;
                                rdfs:range <https://schema.org/Event> ;
                                rdfs:comment "An event that this event is a part of."@en ,
                                             "Un acontecimiento del que forma parte este evento."@es ;
                                rdfs:label "super event"@en ,
                                           "super evento"@es .


#################################################################
#    Data properties
#################################################################

###  http://purl.org/dc/terms/identifier
<http://purl.org/dc/terms/identifier> rdf:type owl:DatatypeProperty ;
                                      rdfs:range xsd:string .


###  https://edint.es/def/agenda#interior
:interior rdf:type owl:DatatypeProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :CityEvent ;
          rdfs:range xsd:boolean ;
          rdfs:comment "Indica si un evento tiene lugar en un sitio cerrado."@es ,
                       "Indicates whether an event is taking place in an enclosed location"@en ;
          rdfs:label "inside"@en ,
                     "interior"@es .


###  https://edint.es/def/agenda#price
:price rdf:type owl:DatatypeProperty ;
       rdfs:domain :CityEvent ;
       rdfs:range xsd:string ;
       rdfs:comment "El precio de un evento."@es ,
                    "The price of an event." ;
       rdfs:label "precio"@es ,
                  "price" .


###  https://edint.es/def/agenda#schedule
:schedule rdf:type owl:DatatypeProperty ;
          rdfs:domain :CityEvent ;
          rdfs:range xsd:string ;
          rdfs:comment "El cronograma de un evento que especifica  el horario de cada día."@es ,
                       "The schedule of an event scpecifying the hours each day."@en ;
          rdfs:label "horario"@es ,
                     "schedule"@en .


###  https://schema.org/audience
<https://schema.org/audience> rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain <https://schema.org/Event> ;
                              rdfs:range xsd:string ;
                              rdfs:comment "El público al que va dirigido el artículo, es decir, el grupo para el que se creó el artículo."@es ,
                                           "Intended audience for an item, i.e. the group for whom the item was created."@en ;
                              rdfs:label "audience"@en ,
                                         "audiencia"@es .


###  https://schema.org/description
<https://schema.org/description> rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "A description of the item."@en ,
                                              "Una descripción del artículo."@es ;
                                 rdfs:label "descripción"@es ,
                                            "description"@en .


###  https://schema.org/doorTime
<https://schema.org/doorTime> rdf:type owl:DatatypeProperty ,
                                       owl:FunctionalProperty ;
                              rdfs:domain <https://schema.org/Event> ;
                              rdfs:range xsd:dateTime ;
                              rdfs:comment "La hora de inicio de la admisión."@es ,
                                           "The time admission will commence."@en ;
                              rdfs:label "hora de apertura"@es ,
                                         "opening time"@en .


###  https://schema.org/encodingFormat
<https://schema.org/encodingFormat> rdf:type owl:DatatypeProperty ,
                                             owl:FunctionalProperty ;
                                    rdfs:domain <https://schema.org/CreativeWork> ;
                                    rdfs:range xsd:string ;
                                    rdfs:comment "File format type"@en ,
                                                 "Tipo del formato del archivo"@es ;
                                    rdfs:label "file format"@en ,
                                               "formato archivo"@es .


###  https://schema.org/endDate
<https://schema.org/endDate> rdf:type owl:DatatypeProperty ,
                                      owl:FunctionalProperty ;
                             rdfs:domain <https://schema.org/Event> ;
                             rdfs:range xsd:dateTime ;
                             rdfs:comment "La fecha y hora de finalización del artículo"@es ,
                                          "The end date and time of the item"@en ;
                             rdfs:label "end date"@en ,
                                        "fecha fin"@es .


###  https://schema.org/eventStatus
<https://schema.org/eventStatus> rdf:type owl:DatatypeProperty ,
                                          owl:FunctionalProperty ;
                                 rdfs:domain <https://schema.org/Event> ;
                                 rdfs:range xsd:string ;
                                 rdfs:comment "An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled."@en ,
                                              "El estado de un evento representa su situación; especialmente útil cuando un evento se cancela o se reprograma."@es ;
                                 rdfs:label "estado del evento"@es ,
                                            "event status"@en .


###  https://schema.org/image
<https://schema.org/image> rdf:type owl:DatatypeProperty ,
                                    owl:FunctionalProperty ;
                           rdfs:range xsd:anyURI ;
                           rdfs:comment "An image of the item."@en ,
                                        "Una imagen del artículo."@es ;
                           rdfs:label "image"@en ,
                                      "imagen"@es .


###  https://schema.org/isAccessibleForFree
<https://schema.org/isAccessibleForFree> rdf:type owl:DatatypeProperty ,
                                                  owl:FunctionalProperty ;
                                         rdfs:domain :CityEvent ;
                                         rdfs:range xsd:boolean ;
                                         rdfs:comment "A flag to signal that the item, event, or place is accessible for free."@en ,
                                                      "Una bandera para señalar que el artículo, evento o lugar es accesible de forma gratuita."@es ;
                                         rdfs:label "es accesible gratis"@es ,
                                                    "is accessible free"@en .


###  https://schema.org/maximumAttendeeCapacity
<https://schema.org/maximumAttendeeCapacity> rdf:type owl:DatatypeProperty ,
                                                      owl:FunctionalProperty ;
                                             rdfs:domain <https://schema.org/Event> ;
                                             rdfs:range xsd:integer ;
                                             rdfs:comment "El número total de personas que pueden asistir a un evento o local."@es ,
                                                          "The total number of individuals that may attend an event or venue."@en ;
                                             rdfs:label "capacidad máxima"@es ,
                                                        "maximun attendee capacity"@en .


###  https://schema.org/name
<https://schema.org/name> rdf:type owl:DatatypeProperty ,
                                   owl:FunctionalProperty ;
                          rdfs:range xsd:string ;
                          rdfs:comment "El nombre de un elemento"@es ,
                                       "The name of the item."@en ;
                          rdfs:label "name" .


###  https://schema.org/startDate
<https://schema.org/startDate> rdf:type owl:DatatypeProperty ,
                                        owl:FunctionalProperty ;
                               rdfs:domain <https://schema.org/Event> ;
                               rdfs:range xsd:dateTime ;
                               rdfs:comment "La fecha y la hora de inicio del artículo"@es ,
                                            "The start date and time of the item"@en ;
                               rdfs:label "fecha inicio"@es ,
                                          "start date"@en .


###  https://schema.org/typicalAgeRange
<https://schema.org/typicalAgeRange> rdf:type owl:DatatypeProperty ,
                                              owl:FunctionalProperty ;
                                     rdfs:domain <https://schema.org/Event> ;
                                     rdfs:range xsd:string ;
                                     rdfs:comment "El rango de edad típico esperado"@es ,
                                                  "The typical expected age range"@en ;
                                     rdfs:label "rango de edad"@es ,
                                                "typical age range"@en .


###  https://schema.org/url
<https://schema.org/url> rdf:type owl:DatatypeProperty ,
                                  owl:FunctionalProperty ;
                         rdfs:range xsd:anyURI ;
                         rdfs:comment "Enlace del artículo"@es ,
                                      "URL of the item"@en ;
                         rdfs:label "enlace"@es ,
                                    "url"@en .


#################################################################
#    Classes
#################################################################

###  http://schema.org/CreativeWork
<http://schema.org/CreativeWork> rdf:type owl:Class ;
                                 rdfs:comment "El tipo más genérico de trabajo creativo, que incluye libros, películas, fotografías, programas informáticos, etc."@es ,
                                              "The most generic kind of creative work, including books, movies, photographs, software programs, etc."@en ;
                                 rdfs:label "Creative work"@en ,
                                            "Trabajo creativo"@es .


###  http://schema.org/Organization
<http://schema.org/Organization> rdf:type owl:Class ;
                                 rdfs:comment "A collection of people organized together into a community or other social, commercial or political structure."@es ,
                                              "a collection of people organized together into a community or other social, commercial or political structure."@en ;
                                 rdfs:label "Organización"@es ,
                                            "Organization"@en .


###  http://schema.org/PostalAddress
<http://schema.org/PostalAddress> rdf:type owl:Class ;
                                  rdfs:comment "Dirección para envío de correo."@es ,
                                               "The mailing address."@en ;
                                  rdfs:label "Dirección postal"@es ,
                                             "Postal address"@en .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                   <http://purl.org/dc/terms/issued> "2014-03-28" ;
                                                                                   rdfs:comment "Comunidad Autónoma o Ciudad Autónoma"@es ;
                                                                                   rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                   rdfs:label "Autonomía"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                <http://purl.org/dc/terms/issued> "2014-03-28" ;
                                                                                rdfs:comment "Un barrio es cada una de las partes en que se dividen los pueblos grandes o sus distritos [fuente: Diccionario de la Real Academia (DRAE) 2011]"@es ;
                                                                                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                rdfs:label "Barrio"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad> rdf:type owl:Class ;
                                                                                rdfs:subClassOf <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> ,
                                                                                                <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                <http://purl.org/dc/terms/issued> "2014-04-15"@es ;
                                                                                rdfs:comment "Una ciudad es un área urbana en la que predominan fundamentalmente la industria y los servicios [fuente: Wikipedia]"@es ;
                                                                                rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                rdfs:label "Ciudad"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito> rdf:type owl:Class ;
                                                                                  rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                  <http://purl.org/dc/terms/issued> "2014-03-28" ;
                                                                                  rdfs:comment "Un distrito es cada una de las demarcaciones en que se subdivide un territorio o una población para distribuir y ordenar el ejercicio de los derechos civiles y políticos, o de las funciones públicas, o de los servicios administrativos [fuente: Diccionario de la Real Academia (DRAE) 2011]"@es ;
                                                                                  rdfs:isDefinedBy <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ;
                                                                                  rdfs:label "Distrito"@es .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                   <http://purl.org/dc/terms/issued> "2014-03-28" ;
                                                                                   rdfs:comment """Un Municipio es el ente local definido en el artículo 140 de la Constitución española y la entidad básica de la organización territorial del Estado según el artículo 1 de la Ley 7/1985, de 2 de abril, Reguladora de las Bases del Régimen Local. Tiene personalidad jurídica y plena capacidad para el cumplimiento de sus fines. La delimitación territorial de Municipio está recogida del REgistro Central de Cartografía del IGN.
Su nombre, que se especifica con la propiedad dct:title, es el proporcionado por el Registro de Entidades Locales del Ministerio de Política Territorial, en http://www.ine.es/nomen2/index.do"""@es ;
                                                                                   rdfs:isDefinedBy <http://purl.org/derecho/vocabulario> ,
                                                                                                    <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ,
                                                                                                    <http://www.ign.es/ign/resources/acercaDe/tablon/ModeloDireccionesAGE.pdf‎> ;
                                                                                   rdfs:label "Municipio"@es ;
                                                                                   rdfs:seeAlso <http://purl.org/derecho/vocabulario#Municipio> .


###  http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia
<http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia> rdf:type owl:Class ;
                                                                                   rdfs:subClassOf <http://www.opengis.net/ont/geosparql#Feature> ;
                                                                                   <http://purl.org/dc/terms/issued> "2014-03-28" ;
                                                                                   rdfs:comment "Cada una de las grandes divisiones de un territorio o Estado, sujeta por lo común a una autoridad administrativa [fuente: Diccionario de la lengua española (DRAE) 2011]"@es ,
                                                                                                """Entidad local con personalidad jurídica propia, determinada por la agrupación de Municipios y división territorial para el cumplimiento de las actividades del Estado. La delimitación territorial de Provincia está recogida en el Registro Central de Cartografía del IGN [fuente: Modelo de Direcciones de la Administración General del Estado v.2]
Su identificador, que se especifica con la propiedad dct:identifier, es el proporcionado por el INE en http://www.ine.es/daco/daco42/codmun/codmun09/09codmun.xls
Su nombre, que se especifica con la propiedad dct:title, es el proporcionado por el Registro de Entidades Locales del Ministerio de Política Territorial, en http://www.ine.es/nomen2/index.do"""@es ;
                                                                                   rdfs:isDefinedBy <http://purl.org/derecho/vocabulario> ,
                                                                                                    <http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio> ,
                                                                                                    <http://www.ign.es/ign/resources/acercaDe/tablon/ModeloDireccionesAGE.pdf‎> ;
                                                                                   rdfs:label "Provincia"@es ;
                                                                                   rdfs:seeAlso <http://purl.org/derecho/vocabulario#Provincia> .


