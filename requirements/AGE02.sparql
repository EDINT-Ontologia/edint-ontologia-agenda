
# AGE02: ¿Qué eventos tienen lugar en un determinado equipamiento?

PREFIX edintagenda: <https://edint.es/def/agenda#>
PREFIX schema: <https://schema.org/>
PREFIX edintinf: <https://edint.es/def/infraestructura#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gsp: <http://www.opengis.net/ont/geosparql#>

SELECT ?event 
WHERE {
  ?event a edintagenda:CityEvent ;
         edintagenda:takesPlace URI_DEL_EQUIPAMIENTO> .
}
