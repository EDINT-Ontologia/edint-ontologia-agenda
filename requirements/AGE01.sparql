
# AGE01: ¿Qué eventos están registrados en la agenda?

PREFIX edintagenda: <https://edint.es/def/agenda#>
PREFIX schema: <https://schema.org/>
PREFIX edintinf: <https://edint.es/def/infraestructura#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX gsp: <http://www.opengis.net/ont/geosparql#>

SELECT ?event ?name
WHERE {
  ?event a edintagenda:CityEvent .
  OPTIONAL { ?event schema:name ?name }
}