<https://astrea.linkeddata.es/shapes#0c9c7e5d2b8bc969402273a9d46220e4> a sh:PropertyShape ;
    rdfs:label "name",
        "The name of the item."@en,
        "El nombre de un elemento"@es ;
    sh:datatype xsd:string ;
    sh:description "The name of the item."@en,
        "El nombre de un elemento"@es ;
    sh:maxCount 1 ;
    sh:name "name" ;
    sh:path schema:name ;
    sh:pattern ".*" .

<https://astrea.linkeddata.es/shapes#2202d590f9336269b8e83c3bc6ae8350> a sh:PropertyShape ;
    rdfs:label "URL of the item"@en,
        "url"@en,
        "Enlace del artículo"@es,
        "enlace"@es ;
    sh:datatype xsd:anyURI ;
    sh:description "URL of the item"@en,
        "Enlace del artículo"@es ;
    sh:maxCount 1 ;
    sh:name "url"@en,
        "enlace"@es ;
    sh:path schema:url ;
    sh:pattern "^(([^:/?#]+):)?(//([^/?#]*))?([^?#]*)(\\?([^#]*))?(#(.*))?" .

