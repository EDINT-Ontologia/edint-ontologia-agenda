    <!-- http://purl.org/dc/terms/identifier -->

    <rdfs:Datatype rdf:about="http://purl.org/dc/terms/identifier"/>
    


    <!-- http://www.w3.org/2001/XMLSchema#date -->

    <rdfs:Datatype rdf:about="http://www.w3.org/2001/XMLSchema#date"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#municipio -->

    <owl:ObjectProperty rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#municipio">
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
        <dcterms:issued>2014-03-28</dcterms:issued>
        <rdfs:comment xml:lang="es">Municipio al que pertenece un fenómeno geográfico o una entidad administrativa</rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio"/>
        <rdfs:label xml:lang="es">pertenece al municipio</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.opengis.net/ont/geosparql#hasGeometry -->

    <owl:ObjectProperty rdf:about="http://www.opengis.net/ont/geosparql#hasGeometry">
        <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Feature"/>
        <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
        <dc:contributor>Matthew Perry</dc:contributor>
        <dc:creator>OGC GeoSPARQL 1.0 Standard Working Group</dc:creator>
        <dc:date rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2011-06-16</dc:date>
        <rdfs:comment xml:lang="en">
      A spatial representation for a given feature.
    </rdfs:comment>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/ont/geosparql"/>
        <rdfs:isDefinedBy rdf:resource="http://www.opengis.net/spec/geosparql/1.0"/>
        <rdfs:label xml:lang="en">hasGeometry</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.w3.org/2004/02/skos/core#inScheme -->

    <owl:ObjectProperty rdf:about="http://www.w3.org/2004/02/skos/core#inScheme">
        <rdfs:range rdf:resource="http://www.w3.org/2004/02/skos/core#ConceptScheme"/>
        <rdfs:comment xml:lang="en">A concept may be a member of more than one concept scheme.</rdfs:comment>
        <rdfs:label xml:lang="en">is in scheme</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#attendanceMode -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#attendanceMode">
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://edint.es/kos/AttendanceMode"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment xml:lang="en">Attendance mode, for example, in person, online.</rdfs:comment>
        <rdfs:comment xml:lang="es">Modalidad de asistencia, por ejemplo, presencial, en línea.</rdfs:comment>
        <rdfs:label xml:lang="en">attendance mode</rdfs:label>
        <rdfs:label xml:lang="es">modalidad de asistencia</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#documentation -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#documentation">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="https://schema.org/DigitalDocument"/>
        <rdfs:comment xml:lang="es">Documentación asociada a un evento</rdfs:comment>
        <rdfs:comment xml:lang="en">Documentation associated with an event</rdfs:comment>
        <rdfs:label xml:lang="es">documentacion</rdfs:label>
        <rdfs:label xml:lang="en">documentation</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#eventStatus -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#eventStatus">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://edint.es/kos/EventStatus"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Estado de un evento, por ejemplo, activo o cancelado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Status of an event, for example, active or cancelled.</rdfs:comment>
        <rdfs:label xml:lang="es">estado del evento</rdfs:label>
        <rdfs:label xml:lang="en">event status</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#eventType -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#eventType">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.w3.org/2004/02/skos/core#inScheme"/>
                <owl:hasValue rdf:resource="https://edint.es/kos/EventType"/>
            </owl:Restriction>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Tipo de evento que tendrá lugar.</rdfs:comment>
        <rdfs:comment xml:lang="en">Type of event to be held.</rdfs:comment>
        <rdfs:label xml:lang="es">tipo de evento</rdfs:label>
        <rdfs:label xml:lang="en">type of event</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#isHeldIn -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#isHeldIn">
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Autonomia"/>
                    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Barrio"/>
                    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Ciudad"/>
                    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Distrito"/>
                    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Municipio"/>
                    <rdf:Description rdf:about="http://vocab.linkeddata.es/datosabiertos/def/sector-publico/territorio#Provincia"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <rdfs:comment xml:lang="es">Relación entre el Evento y la entidad administrativa en donde se celebra, por ejemplo el Barrio o el Distrito.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between the Event and the administrative entity where it is held in, for example the Neighborhood or the District.</rdfs:comment>
        <rdfs:label xml:lang="en">is held in</rdfs:label>
        <rdfs:label xml:lang="es">se celebra en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#organizedBy -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#organizedBy">
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="http://schema.org/Organization"/>
        <rdfs:comment xml:lang="es">Relación entre el evento y la organización que lo gestiona.</rdfs:comment>
        <rdfs:comment xml:lang="en">Relationship between the event and the organization that manages it.</rdfs:comment>
        <rdfs:label xml:lang="es">organizadoPor</rdfs:label>
        <rdfs:label xml:lang="en">organizedBy</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#takesPlaceIn -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#takesPlaceIn">
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="https://edint.es/def/infraestructura#Facility"/>
        <rdfs:comment xml:lang="es">El lugar en donde se realiza el evento.</rdfs:comment>
        <rdfs:comment xml:lang="es">The venue where the event takes place.</rdfs:comment>
        <rdfs:label xml:lang="en">takes place in</rdfs:label>
        <rdfs:label xml:lang="es">tiene lugar en</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://edint.es/def/agenda#workPerformed -->

    <owl:ObjectProperty rdf:about="https://edint.es/def/agenda#workPerformed">
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="https://schema.org/CreativeWork"/>
        <rdfs:comment xml:lang="en">A work performed in some event, for example a play performed in a theater event.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una obra representada en algún evento, por ejemplo, una obra de teatro representada en un evento teatral.</rdfs:comment>
        <rdfs:label xml:lang="es">obra presentada</rdfs:label>
        <rdfs:label xml:lang="en">work performed</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/address -->

    <owl:ObjectProperty rdf:about="https://schema.org/address">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#DireccionPostal"/>
        <rdfs:comment xml:lang="es">Dirección física del artículo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Physical address of the item.</rdfs:comment>
        <rdfs:label xml:lang="en">address</rdfs:label>
        <rdfs:label xml:lang="es">dirección</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/subEvent -->

    <owl:ObjectProperty rdf:about="https://schema.org/subEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="https://schema.org/Event"/>
        <rdfs:comment xml:lang="en">An Event that is part of this event.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un evento que forma parte de este evento.</rdfs:comment>
        <rdfs:label xml:lang="en">sub event</rdfs:label>
        <rdfs:label xml:lang="es">sub evento</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- https://schema.org/superEvent -->

    <owl:ObjectProperty rdf:about="https://schema.org/superEvent">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="https://schema.org/Event"/>
        <rdfs:comment xml:lang="en">An event that this event is a part of.</rdfs:comment>
        <rdfs:comment xml:lang="es">Un acontecimiento del que forma parte este evento.</rdfs:comment>
        <rdfs:label xml:lang="en">super event</rdfs:label>
        <rdfs:label xml:lang="es">super evento</rdfs:label>
    </owl:ObjectProperty>
    


