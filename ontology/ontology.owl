    // Data properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://purl.org/dc/terms/identifier -->

    <owl:DatatypeProperty rdf:about="http://purl.org/dc/terms/identifier">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/agenda#interior -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/agenda#interior">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
        <rdfs:comment xml:lang="es">Indica si un evento tiene lugar en un sitio cerrado.</rdfs:comment>
        <rdfs:comment xml:lang="en">Indicates whether an event is taking place in an enclosed location</rdfs:comment>
        <rdfs:label xml:lang="en">inside</rdfs:label>
        <rdfs:label xml:lang="es">interior</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/agenda#price -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/agenda#price">
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">El precio de un evento.</rdfs:comment>
        <rdfs:comment>The price of an event.</rdfs:comment>
        <rdfs:label xml:lang="es">precio</rdfs:label>
        <rdfs:label>price</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://edint.es/def/agenda#schedule -->

    <owl:DatatypeProperty rdf:about="https://edint.es/def/agenda#schedule">
        <rdfs:domain rdf:resource="https://edint.es/def/agenda#CityEvent"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">El cronograma de un evento que especifica  el horario de cada día.</rdfs:comment>
        <rdfs:comment xml:lang="en">The schedule of an event scpecifying the hours each day.</rdfs:comment>
        <rdfs:label xml:lang="es">horario</rdfs:label>
        <rdfs:label xml:lang="en">schedule</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/audience -->

    <owl:DatatypeProperty rdf:about="https://schema.org/audience">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="es">El público al que va dirigido el artículo, es decir, el grupo para el que se creó el artículo.</rdfs:comment>
        <rdfs:comment xml:lang="en">Intended audience for an item, i.e. the group for whom the item was created.</rdfs:comment>
        <rdfs:label xml:lang="en">audience</rdfs:label>
        <rdfs:label xml:lang="es">audiencia</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/description -->

    <owl:DatatypeProperty rdf:about="https://schema.org/description">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">A description of the item.</rdfs:comment>
        <rdfs:comment xml:lang="es">Una descripción del artículo.</rdfs:comment>
        <rdfs:label xml:lang="es">descripción</rdfs:label>
        <rdfs:label xml:lang="en">description</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/doorTime -->

    <owl:DatatypeProperty rdf:about="https://schema.org/doorTime">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">La hora de inicio de la admisión.</rdfs:comment>
        <rdfs:comment xml:lang="en">The time admission will commence.</rdfs:comment>
        <rdfs:label xml:lang="es">hora de apertura</rdfs:label>
        <rdfs:label xml:lang="en">opening time</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/encodingFormat -->

    <owl:DatatypeProperty rdf:about="https://schema.org/encodingFormat">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/CreativeWork"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">File format type</rdfs:comment>
        <rdfs:comment xml:lang="es">Tipo del formato del archivo</rdfs:comment>
        <rdfs:label xml:lang="en">file format</rdfs:label>
        <rdfs:label xml:lang="es">formato archivo</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/endDate -->

    <owl:DatatypeProperty rdf:about="https://schema.org/endDate">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
        <rdfs:comment xml:lang="es">La fecha y hora de finalización del artículo</rdfs:comment>
        <rdfs:comment xml:lang="en">The end date and time of the item</rdfs:comment>
        <rdfs:label xml:lang="en">end date</rdfs:label>
        <rdfs:label xml:lang="es">fecha fin</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- https://schema.org/eventStatus -->

    <owl:DatatypeProperty rdf:about="https://schema.org/eventStatus">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="https://schema.org/Event"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:comment xml:lang="en">An eventStatus of an event represents its status; particularly useful when an event is cancelled or rescheduled.</rdfs:comment>
        <rdfs:comment xml:lang="es">El estado de un evento representa su situación; especialmente útil cuando un evento se cancela o se reprograma.</rdfs:comment>
        <rdfs:label xml:lang="es">estado del evento</rdfs:label>
