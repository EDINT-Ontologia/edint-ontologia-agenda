<?xml version="1.0"?>
<rdf:RDF xmlns="https://edint.es/def/agenda#"
     xml:base="https://edint.es/def/agenda"
     xmlns:dc="http://purl.org/dc/elements/1.1/"
     xmlns:gsp="http://www.opengis.net/ont/geosparql#"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:vann="http://purl.org/vocab/vann/"
     xmlns:esdir="http://vocab.linkeddata.es/datosabiertos/def/urbanismo-infraestructuras/direccion-postal#"
     xmlns:schema="https://schema.org/"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:edintinf="https://edint.es/def/infraestructura#"
     xmlns:edintkos="https://edint.es/kos/"
     xmlns:edintagenda="https://edint.es/def/agenda#">
    <owl:Ontology rdf:about="https://edint.es/def/agenda">
        <owl:versionIRI rdf:resource="https://edint.es/def/agenda"/>
        <dcterms:created>2026-05-05</dcterms:created>
        <dcterms:creator>Daniel Doña</dcterms:creator>
        <dcterms:creator>Edna Ruckhaus</dcterms:creator>
        <dcterms:creator>Lucía Sánchez</dcterms:creator>
        <dcterms:creator>Socorro Bernardos</dcterms:creator>
        <dcterms:description xml:lang="es">The Agenda ontology represents the agenda of cultural, sporting and social events that take place in the municipality.</dcterms:description>
        <dcterms:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-05-05</dcterms:issued>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
        <dcterms:title xml:lang="es">Vocabulario para la representación de la agenda cultural, deportiva y social de un municipio</dcterms:title>
        <dcterms:title xml:lang="en">Vocabulary for the representation of the cultural, sporting and social agenda of a municipality</dcterms:title>
        <vann:preferredNamespacePrefix>edintagenda</vann:preferredNamespacePrefix>
        <vann:preferredNamespaceUri>https://edint.es/def/agenda#</vann:preferredNamespaceUri>
        <rdfs:comment>https://edint.es/def/agenda</rdfs:comment>
        <owl:priorVersion rdf:resource="https://github.com/EDINT-Ontologia/edint-ontologia-agenda/releases/tag/v0.1.0"/>
        <owl:versionInfo>0.1.1</owl:versionInfo>
    </owl:Ontology>
    


